{
  "name": "atrium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude proposes trades on the Stellar DEX; your backend enforces policy, signs and submits. Live watch dashboard.",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "npm --prefix web run dev",
    "start": "tsx src/server.ts",
    "backtest": "tsx src/backtest/cli.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "trustlines": "tsx src/stellar/trustlines.ts",
    "build": "npm --prefix web install && npm --prefix web run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin:totp-setup": "tsx scripts/admin-setup.ts totp",
    "admin:hash-password": "tsx scripts/admin-setup.ts hash",
    "build:admin": "npm --prefix admin-web run build",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:sync": "npm run build && cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@sentry/node": "^10.64.0",
    "@stellar/stellar-sdk": "^16.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "mssql": "^12.5.5",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@types/express": "^5.0.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.10.0",
    "concurrently": "^10.0.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
