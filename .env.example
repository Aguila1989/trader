# =============================================================
# Atrium - configuration
# Copy this file to .env and fill in the values.
# NEVER commit your real .env file.
# =============================================================

# --- Network -------------------------------------------------
# 'testnet' (start here) or 'public' (mainnet = REAL money)
NETWORK=testnet
# Optional. Defaults are derived from NETWORK when left empty.
# HORIZON_URL=https://horizon-testnet.stellar.org

# --- Wallet --------------------------------------------------
# Since Feature 3 (per-user wallet creation/import), STELLAR_PUBLIC/STELLAR_SECRET
# are the SEED wallet of the DEFAULT account only: they keep a single-operator
# deployment and the background autopilot/monitor loops signing as before. Each
# logged-in user instead sets up their OWN wallet in the app, encrypted at rest
# (see WALLET_ENCRYPTION_KEY); users NEVER fall back to this key.
# Public key (G...) of the default account you watch and trade from.
STELLAR_PUBLIC=
# Secret key (S...) used ONLY by the backend signer for the DEFAULT account.
# Leave EMPTY for a pure multi-user deployment (each user supplies their own
# wallet); the default account is then read-only (background loops cannot sign).
# Use a SEPARATE small hot wallet, NEVER your main wallet.
# This value is read by your backend only - it is NEVER sent to the AI.
STELLAR_SECRET=

# --- AI provider ---------------------------------------------
# The bot can run on ANY LLM. Pick a provider, give it a key + model.
#
# AI_PROVIDER: which LLM drives the analyst.
#   anthropic  -> native Claude (prompt caching + extended thinking). DEFAULT.
#   openai     -> OpenAI (gpt-4o, gpt-4o-mini, ...)
#   deepseek   -> DeepSeek (deepseek-chat, deepseek-reasoner)
#   openrouter -> OpenRouter: ONE key, ANY model (Claude, Gemini, Llama, ...)
#   groq | mistral | xai | together -> their OpenAI-compatible endpoints
#   (any other value) -> custom; you MUST also set AI_BASE_URL.
# Everything except "anthropic" speaks the OpenAI chat-completions dialect, so a
# local server (Ollama, LM Studio) works too via AI_BASE_URL.
AI_PROVIDER=anthropic
# API key for the chosen provider. For AI_PROVIDER=anthropic this can be left
# blank and ANTHROPIC_API_KEY below is used instead (back-compat).
AI_API_KEY=
# Model id for the chosen provider. Blank + anthropic falls back to
# ANTHROPIC_MODEL below. Examples per provider:
#   anthropic:  claude-opus-4-7 | claude-sonnet-4-6 | claude-haiku-4-5
#   openai:     gpt-4o | gpt-4o-mini
#   deepseek:   deepseek-chat | deepseek-reasoner
#   openrouter: anthropic/claude-sonnet-4.6 | openai/gpt-4o | google/gemini-2.5-pro
AI_MODEL=
# Optional base-URL override. Blank uses the provider's known default; required
# for a custom/local endpoint, e.g. http://localhost:11434/v1 (Ollama). Local
# servers still need a non-empty AI_API_KEY (any dummy value like "local" works).
AI_BASE_URL=

# --- Per-provider keys (populate the dashboard dropdown) -----
# AI_API_KEY/AI_MODEL/AI_BASE_URL above configure ONLY the active provider. To
# offer SEVERAL providers in the dashboard's dropdown (and switch between them
# live, no restart), give each one its own {PREFIX}_API_KEY (and optionally
# {PREFIX}_MODEL / {PREFIX}_BASE_URL). Every provider with a key configured shows
# up in the dropdown; the rest are hidden. Known prefixes + their default models:
#   ANTHROPIC  (Claude)     -> see the section below
#   OPENAI                  -> gpt-4o
#   DEEPSEEK                -> deepseek-chat
#   OPENROUTER              -> anthropic/claude-sonnet-4.6  (one key, any model)
#   GROQ                    -> llama-3.3-70b-versatile
#   MISTRAL                 -> mistral-large-latest
#   XAI     (Grok)          -> grok-2-latest
#   TOGETHER                -> meta-llama/Llama-3.3-70B-Instruct-Turbo
# Example: keep Claude active but also expose OpenAI in the dropdown:
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o        (optional; defaults as above)

# --- Claude / Anthropic (the ANTHROPIC_* provider) -----------
# The anthropic provider's per-provider settings (and the dropdown's "Claude"
# entry). Also the fallback for the generic AI_API_KEY/AI_MODEL when
# AI_PROVIDER=anthropic, so existing single-provider setups keep working.
ANTHROPIC_API_KEY=
# claude-opus-4-7 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-4-6
# Extended-thinking budget (tokens) the analyst uses to reason BEFORE proposing.
# ANTHROPIC/Claude ONLY (OpenAI-compatible providers ignore this).
# 0 = off (cheapest/fastest). Any positive value enables it (floored at 1024).
# Higher = deeper analysis, more tokens/cost. Try 2000-4000 once it's earning.
ANTHROPIC_THINKING_BUDGET=0

# --- Execution mode ------------------------------------------
# false = every policy-passing proposal waits for you to click Approve (default).
# true  = AUTO-TRADE: policy-passing proposals execute automatically within the
#         hard limits below, with no manual click. Toggle it live on the
#         dashboard ("Approve every trade <-> Auto-trade"). Start with false.
AUTO_APPROVE_ENABLED=false
# DEPRECATED + ignored: the trading access mode (read-only / paper / live) now
# persists in the database and is restored at boot exactly as you last set it
# on the dashboard. The mode never changes automatically. Remove this line.
AUTO_ARM_LIVE_TRADING=false
# Hands-free scanning. 0 = off (default): the bot only analyzes when you click
# "Ask AI" or "Scan chain". When > 0, the backend scans the curated token
# universe every N seconds ON ITS OWN, so it can trade without you scanning
# first. Proposals still pass the SAME gates - they only submit when AUTO-TRADE
# is on AND live trading is armed AND policy passes; otherwise they queue for
# approval. Floored at 30s. NOTE: each scan calls your LLM provider, so a short
# interval costs tokens continuously. Try 300 (5 min) to start.
# FULLY hands-free on mainnet = AUTO_SCAN_INTERVAL_SECONDS>0 + AUTO_APPROVE_ENABLED=true
# + Live trading armed on the dashboard. Dry-run on testnet first.
AUTO_SCAN_INTERVAL_SECONDS=0

# --- Liquidity scanner (observe-only) ------------------------
# Hourly background job that ranks the top-N most XLM-liquid Stellar assets,
# persists snapshots, computes trend/consistency, and flags non-whitelisted
# "worth watching" candidates on the dashboard. It DECOUPLED from trading: it
# never proposes or submits anything - an operator promotes a candidate by hand
# into SCAN_ASSETS / ASSET_WHITELIST. 0 = off. Floored at 300s; 3600 = hourly.
LIQUIDITY_SCAN_INTERVAL_SECONDS=0
# How far back the analyzer/history window looks. Default 30 days.
LIQUIDITY_RETENTION_DAYS=30
# Best-effort discovery depth: pages of Horizon /assets swept to find NEW
# candidates (Horizon can't sort /assets by volume, so this is a bounded proxy
# ranked by holders then re-ranked by measured XLM volume). 0 = curated+whitelist
# only (no new-asset discovery).
LIQUIDITY_DISCOVERY_PAGES=2

# --- Weekly AI trustline scan (Feature 4) --------------------
# A decoupled, observe-only weekly job: it ranks the top Stellar tokens (+ the
# tokens you already hold), scores each as a trustline candidate via the AI,
# persists a weekly snapshot (>=12 weeks history), and derives add-SUGGESTIONS +
# deterioration WARNINGS. It NEVER trades and NEVER adds/removes a trustline.
# Master switch (true = on).
TRUSTLINE_SCAN_ENABLED=true
# When the scan runs: a fixed weekday + local time in TIMEZONE (above). Day:
# 0=Sun..6=Sat (default Monday); time: minutes after local midnight, 0-1439
# (default 180 = 03:00). On a fresh install the first scan waits for this slot;
# use the "Run Now" button in the Bot tab for an immediate first scan.
TRUSTLINE_SCAN_DAY_OF_WEEK=1
TRUSTLINE_SCAN_MINUTE_OF_DAY=180
# How many top tokens (by measured 24h XLM volume) to analyse each scan (1-25).
TRUSTLINE_SCAN_TOP_N=10
# Weeks of per-token scan history to retain (>=12 required by the spec).
TRUSTLINE_SCAN_RETENTION_WEEKS=16
# Minimum overall score (1-10) a token needs to appear as a SUGGESTION. Scored
# tokens below it are hidden; tokens whose AI evaluation was unavailable are
# never suggested (they show separately as "unscored - evaluate manually").
# 0 shows every scored token. Also editable live in the settings panel.
TRUSTLINE_SCAN_MIN_SCORE=6

# --- Chain scan ----------------------------------------------
# "Scan chain" checks a curated set of reputable credit tokens (each quoted
# against XLM) in one pass. These are MAINNET issuers; on testnet supply your
# own here. Comma-separated "CODE:ISSUER". Leave blank for the curated default:
#   HIGH tier (bigger size): USDC, EURC
#   LOW  tier (standard size): AQUA, yXLM, yUSDC, SHX, ARST, NGNT, LSP, AFR,
#                              GOLD (mintx.co), USDT (stellarstable.co anchor)
# Scanned tokens are auto-added to the whitelist. Every curated issuer was
# verified against the live ledger (dominant issuer + real home_domain + a live
# XLM order book) - re-verify before adding your own; a wrong issuer can be a
# scam clone of a well-known ticker.
# SCAN_ASSETS=
#
# CROSS pairs scanned ALONGSIDE the XLM markets - books whose liquidity an
# XLM-only scan cannot see. Comma-separated "BASE/QUOTE"; each leg is a full
# CODE:ISSUER spec, a bare curated code (USDC -> the curated issuer), or XLM.
# Legs are auto-whitelisted. Default (both verified liquid on mainnet):
#   USDC/EURC   - a EUR/USD fx proxy (~20bps spread, real daily flow)
#   yUSDC/USDC  - a redeemable PEG pair near 1.0 (bounded mean reversion)
# Set "none" to disable cross pairs entirely.
# SCAN_PAIRS=USDC/EURC,yUSDC/USDC

# --- Policy / risk limits (HARD guardrails) ------------------
# Comma-separated whitelist. Format: XLM (native) or CODE:ISSUER
# You need at least TWO whitelisted assets to form a trading pair.
# (The SCAN_ASSETS tokens above + XLM are merged into this list automatically.)
# Example issued asset:
#   USDC:GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
ASSET_WHITELIST=XLM
# Max size of a single trade, in BASE asset units. This STANDARD cap applies to
# LOW-tier and custom/unknown assets (the safe default for thinner books).
MAX_AMOUNT_PER_TRADE=10
# Larger per-trade cap, used ONLY when an XLM-based pair's other leg is a
# curated HIGH-tier blue-chip (USDC, EURC) - deep, low-volatility names where a
# bigger clip is safe. Floored at MAX_AMOUNT_PER_TRADE. CROSS pairs (no XLM
# leg, e.g. USDC/EURC) always keep the STANDARD cap: these caps are in BASE
# units, and 50 USDC is ~5x the real size of 50 XLM.
MAX_AMOUNT_PER_TRADE_HIGH=50
# Max total traded notional per day, in XLM-EQUIVALENT units (cross-pair trades
# are converted via live XLM rates so one cap spans every market).
MAX_DAILY_VOLUME=500
# Max number of submitted trades per day
MAX_TRADES_PER_DAY=100
# Max realized loss per day before trading halts. Normalized to XLM, so a single
# cap is meaningful even when trades settle against different quote assets.
MAX_DAILY_LOSS=25
# Max allowed slippage in basis points (100 bps = 1%)
MAX_SLIPPAGE_BPS=50
# Hard ceiling (bps) on the client slippage for a wallet SWAP (/api/swap).
# Decoupled from the tight trade cap above so disposing an illiquid token to XLM
# can tolerate a wider spread, while still bounding the min received away from 0
# (SEC-07). 1000 bps = 10%.
MAX_SWAP_SLIPPAGE_BPS=1000
# Minimum seconds between two submitted trades
TRADE_COOLDOWN_SECONDS=60
# Max per-operation network fee (in stroops). The signer always BIDS this cap as
# its max fee, but Stellar only charges the market-clearing fee - so in calm
# markets you still pay the base fee (100 stroops) and only pay more when surge
# pricing kicks in, up to this ceiling. Floored at the network base fee.
# 100000 stroops = 0.01 XLM - enough to push a trade through during congestion.
MAX_FEE_STROOPS=100000
# Daily OUTFLOW cap for the wallet endpoints (/api/pay sends), on top of the
# kill switch + asset-whitelist gates those endpoints now enforce (SEC-01).
# Counted at face value: XLM exactly, other whitelisted assets at nominal sent
# amount. 0 (default) disables the velocity cap; the whitelist gate still applies.
MAX_DAILY_EGRESS=0
# SEC-09: hard ceiling on a SINGLE pay/swap (face value, same units as
# MAX_DAILY_EGRESS). Bounds the blast radius of one money-movement call. 0
# (default) disables the per-call ceiling.
MAX_TRANSFER_AMOUNT=0

# --- Trade-quality gates (entries only; exits are exempt) ----
# Refuse to OPEN a position when the live top-of-book spread is wider than this
# (bps). A wide spread means the round trip starts deep in the red. 0 = off.
MAX_ENTRY_SPREAD_BPS=100
# Refuse to OPEN a position in a market with less than this 24h traded volume
# (base units - XLM for every chain-scan pair). Dead markets fill badly and
# exit worse. 0 = off.
MIN_VOLUME_24H=500
# Minimum reward/risk ratio enforced when the AI states BOTH target_price and
# invalidation_price on a proposal (it is instructed to always do so). 0 = off.
MIN_RISK_REWARD=1.2
# Refuse to EXECUTE a proposal older than this many seconds - its limit price
# was set against a market that has moved on (mainly the manual-approval path).
# Re-analyze instead of submitting a stale price. 0 = off.
MAX_PROPOSAL_AGE_SECONDS=600

# --- Exposure caps (entries only) ----------------------------
# Cap on TOTAL open exposure across all pairs, in XLM-equivalent. Daily volume
# bounds activity, not accumulation - this stops the bot building one big
# directional book inside the volume cap. 0 = off.
MAX_OPEN_EXPOSURE=150
# Per-pair net-position cap as a multiple of that pair's per-trade cap
# (3 = a pair's position can never exceed 3 full-size trades).
PAIR_EXPOSURE_MULTIPLIER=3

# --- Position monitor (exit management) ----------------------
# Cadence (seconds) of the background monitor. Each tick it: marks open
# positions to market (unrealized losses count toward MAX_DAILY_LOSS and taper
# the size cap), proposes stop-loss closes, books later fills of resting
# offers, cancels stale offers, records +1h/+24h outcome marks on every trade,
# and re-checks timed-out submissions that landed late. A few Horizon reads,
# no LLM calls. Floored at 15s. 0 = OFF (no exit management - not recommended).
POSITION_MONITOR_INTERVAL_SECONDS=60
# Propose a CLOSE when an open position is this % under water vs its average
# entry. The close passes the policy engine like any trade, but as a
# RISK-REDUCING exit it AUTO-SUBMITS whenever live (or paper) trading is armed -
# even in manual-approval mode - so a stop never waits for a click. Closes are
# also EXEMPT from cooldown/daily caps/staleness so a stop can never be locked
# out (the kill switch still blocks everything).
STOP_LOSS_PCT=5
# First-class STOP LOSS records (manual from the token detail page, or AI-set
# and trailed during the loop) are enforced by the SAME position monitor above,
# taking precedence over STOP_LOSS_PCT/invalidation_price. This caps how many
# times a failed stop-loss SELL is retried before an alert is logged + audited;
# the stop stays Active and keeps retrying (spaced by the monitor's throttle).
STOP_LOSS_MAX_RETRIES=3
# Cancel a RESTING offer after this many minutes unfilled. A stale resting
# order fills exactly when the market turns against it and locks balance
# meanwhile. The default leaves PATIENT limit entries (a maker-side resting
# buy at support) enough time to get hit while still bounding staleness.
# Only tracked (bot-placed) offers are cancelled. 0 = off.
MAX_OFFER_AGE_MINUTES=30

# --- Day boundary --------------------------------------------
# IANA timezone that defines when "per day" rolls over for the daily caps
# (MAX_DAILY_VOLUME, MAX_TRADES_PER_DAY, MAX_DAILY_LOSS) and the day key used to
# persist/restore same-day counters. Default UTC. Set to your local zone (e.g.
# Europe/Brussels, America/New_York) so the reset lines up with your day. An
# invalid value falls back to UTC.
TIMEZONE=UTC

# --- Server --------------------------------------------------
PORT=3000
# Network interface to bind. Default 127.0.0.1 keeps the dashboard + API on THIS
# machine only (recommended for a local hot-wallet bot). Set 0.0.0.0 ONLY if you
# put your own auth/reverse-proxy in front: the API can trigger REAL trades.
BIND_HOST=127.0.0.1
# DEPRECATED (Feature 2). The single shared DASHBOARD_TOKEN has been REPLACED by
# the per-user login flow below (email + password -> signed JWT in an httpOnly
# cookie). It is no longer used for auth; leave it blank. Remove it entirely once
# you've migrated.
DASHBOARD_TOKEN=

# --- Authentication (Feature 2: login / JWT sessions) -------------------
# REQUIRED. The server REFUSES TO START without this (and rejects one < 32 chars).
# It signs the session JWTs. Generate a strong one: `openssl rand -hex 32`.
# Rotating it logs everyone out (all existing sessions become invalid).
JWT_SECRET=
# REQUIRED (Feature 3: wallet creation/import). The server REFUSES TO START
# without this (and rejects one < 32 chars). It encrypts every user's wallet
# secret key at rest (AES-256-GCM, per-user derived key). Generate a strong one:
# `openssl rand -hex 32`. NEVER commit it. Rotating it makes every stored wallet
# undecryptable until re-encrypted, so keep it stable and backed up securely.
WALLET_ENCRYPTION_KEY=
# Session lifetimes. A normal login lasts AUTH_SESSION_HOURS; ticking
# "Remember me" extends it to AUTH_REMEMBER_ME_DAYS.
AUTH_SESSION_HOURS=24
AUTH_REMEMBER_ME_DAYS=30
# Account lockout: lock for AUTH_LOCKOUT_MINUTES after AUTH_MAX_FAILED_LOGINS
# consecutive failed logins.
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
# Per-IP request cap on the /api/auth/* endpoints, per minute.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Link lifetimes: password-reset (minutes) and email-verification (hours).
AUTH_RESET_TOKEN_MINUTES=60
AUTH_VERIFY_TOKEN_HOURS=24
# With SMTP off, raw password-reset links print to the server console on
# TESTNET only (dev convenience). On MAINNET the raw link is a full
# account-takeover credential and is never printed unless you explicitly set
# this true - configure SMTP instead.
AUTH_DEV_RESET_LINKS=false
# Set the Secure flag on auth cookies. Blank = AUTO (on for a non-loopback bind,
# off on the loopback http default so the cookie is actually sent). true|false
# to force.
AUTH_COOKIE_SECURE=
# Absolute base URL used in emailed links (verification / reset). Blank =
# http://<BIND_HOST>:<PORT>. Set your real https origin in production.
PUBLIC_BASE_URL=

# --- Email (SMTP) - OPTIONAL ------------------------------------------------
# Transactional email for verification + password-reset links. When SMTP_HOST is
# BLANK, email is disabled: new accounts are auto-verified and a warning is
# logged; reset links print to the server console on TESTNET only (see
# AUTH_DEV_RESET_LINKS above for the mainnet stance).
# nodemailer is loaded lazily and is optional (`npm i nodemailer` to enable).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# true for an implicit-TLS port (465); false for STARTTLS (587).
SMTP_SECURE=false

# CSRF allowlist: extra browser origins permitted to make state-changing POSTs,
# comma-separated (e.g. https://trader.example.com). Loopback origins pass on a
# loopback bind; a CONCRETE non-loopback BIND_HOST (e.g. 192.168.1.5) auto-allows
# its own host:port. But a WILDCARD bind (BIND_HOST=0.0.0.0) can't infer the host,
# so you MUST list the exact host:port you open the dashboard at here, or POSTs
# get a 403. Blank = loopback / concrete-bind same-origin only.
DASHBOARD_TRUSTED_ORIGINS=
# SEC-22: trust a reverse proxy's X-Forwarded-Host / X-Forwarded-Proto headers.
# OFF by default so a client can't smuggle a forged X-Forwarded-Host past the
# CSRF host allow-list. Set true ONLY behind a proxy you control.
TRUST_PROXY=false
# SEC-01: allow RAW external transfers via POST /api/pay (send funds to an
# arbitrary address). OFF by default - the trading bot never needs to pay a third
# party, so a compromised dashboard can't drain the wallet here. Turn on only for
# a deliberate manual payout; the whitelist + MAX_DAILY_EGRESS still apply.
ALLOW_RAW_TRANSFERS=false
# DEPRECATED (Feature 2). This guarded against an exposed bind with no
# DASHBOARD_TOKEN. Auth is now MANDATORY (JWT_SECRET required + login required for
# every API route), so an exposed bind is always authenticated and this flag is
# no longer consulted. The exposed-bind TLS guard (ALLOW_INSECURE_EXPOSED) still
# applies. Safe to remove.
ALLOW_EXPOSED_WITHOUT_TOKEN=false
# SEC-14: the server REFUSES to start on a non-loopback bind unless you
# acknowledge TLS is terminated upstream (else the token crosses the wire in
# cleartext). Set true ONLY when HTTPS sits in front.
ALLOW_INSECURE_EXPOSED=false

# --- Database (Microsoft SQL Server) -------------------------
# OPTIONAL. Leave everything blank to run fully in-memory (no history persists).
# When configured, trades + daily counters persist and the dashboard's
# Evolution charts and Trade history table are restored across restarts.
# The app auto-creates the database and tables on first boot. You can also create
# the schema explicitly (e.g. before first run, or to upgrade an existing DB):
#   docker compose up -d   &&   npm run db:migrate
# `npm run db:migrate` is the standalone, idempotent migration (safe to re-run).
#
# Quickest local DB:  docker compose up -d   (see docker-compose.yml)
# SEC-11: docker-compose reads MSSQL_SA_PASSWORD from here (no hardcoded default);
# it must match SQLSERVER_PASSWORD below. Choose a strong value.
MSSQL_SA_PASSWORD=Your_strong_Pass123
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=stellar_trader
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=Your_strong_Pass123
# On mainnet (NETWORK=public) the app REFUSES to start without a database, so
# daily loss/volume/trade caps + realized PnL survive a restart (otherwise the
# MAX_DAILY_LOSS guard silently resets to zero on every reboot). Set this true
# to override and accept that risk. Leave false on mainnet unless you must.
ALLOW_MAINNET_WITHOUT_DB=false
# SEC-12: encrypt the DB connection. Default (unset) is TRUE + verify the cert.
# The local docker image ships a self-signed cert, so for LOCAL DEV set
# ENCRYPT=false (or keep encrypt=true and TRUST_CERT=true). For mainnet/shared
# DBs use a real, verified cert: SQLSERVER_ENCRYPT=true + SQLSERVER_TRUST_CERT=false.
SQLSERVER_ENCRYPT=false
# DEV ONLY. Trust a self-signed server cert. Leave UNSET (default false) in
# production - trusting any cert allows a DB MITM.
SQLSERVER_TRUST_CERT=true
# Connection-pool sizing + timeouts (discrete-config path only; a full
# connection string keeps the driver defaults). POOL_MAX is a real concurrency
# ceiling for a multi-user deployment - raise it if requests queue on the DB.
SQLSERVER_POOL_MAX=5
SQLSERVER_POOL_IDLE_MS=30000
SQLSERVER_CONNECT_TIMEOUT_MS=15000
SQLSERVER_REQUEST_TIMEOUT_MS=30000
# SEC-12: on mainnet (NETWORK=public) the app REFUSES to start if a REMOTE DB
# connection is insecure (encryption off or TrustServerCertificate=true). A
# loopback/local DB (e.g. the docker container above) is always exempt. Set true
# to accept an insecure link to a remote DB anyway.
ALLOW_INSECURE_DB=false
# HARDENING (mainnet / shared DB): don't use 'sa'. Pre-create the database and a
# least-privilege login (db_datareader + db_datawriter only), then point the app
# at it via SQLSERVER_CONNECTION_STRING so it skips the CREATE DATABASE bootstrap
# it can't perform without elevated rights. Prefer SQLSERVER_ENCRYPT=true with a
# real, verified certificate (SQLSERVER_TRUST_CERT=false) over trusting any cert.
# See the README "Database hardening" section.
# Alternative to the discrete settings above: a full connection string.
# If set, it takes precedence over SQLSERVER_HOST/USER/PASSWORD/etc.
# SQLSERVER_CONNECTION_STRING=Server=localhost,1433;Database=stellar_trader;User Id=sa;Password=Your_strong_Pass123;Encrypt=false;TrustServerCertificate=true

# ============================================================================
# Premium subscriptions + platform fees (Feature 2, 2026-07)
# ============================================================================
# Stripe is hand-rolled REST (no SDK). Leave STRIPE_SECRET_KEY empty to disable
# billing entirely (the pricing page shows "not configured"; AI stays locked).
STRIPE_SECRET_KEY=
# The webhook endpoint (/api/billing/webhook, public + HMAC-verified) needs the
# signing secret from your Stripe dashboard. Required for subscription events.
STRIPE_WEBHOOK_SECRET=
# The Stellar account that RECEIVES all trade fees. Seeds the admin-editable
# dbo.PlatformSettings row on first boot; after that, change it in the admin
# backoffice (never redeploy). Fees are DISABLED until this is set.
PLATFORM_FEE_WALLET=
# Default premium prices (EUR), editable later in the admin backoffice.
PREMIUM_PRICE_MONTHLY_EUR=10
PREMIUM_PRICE_ANNUAL_EUR=96
# Local time (minutes after midnight, in TIMEZONE) for the daily volume-tier
# recalculation job. Default 00:10.
TIER_RECALC_MINUTE_OF_DAY=10

# ============================================================================
# Admin backoffice (Feature 4, 2026-07) — served at /admin, fully isolated
# ============================================================================
# Credentials live ONLY here, never in the user database. All three are REQUIRED
# for /admin to accept logins. Generate them:
#   npm run admin:hash-password -- "your-strong-admin-password"   -> ADMIN_PASSWORD_HASH
#   npm run admin:totp-setup                                       -> ADMIN_TOTP_SECRET (+ QR URI)
# TOTP (Google Authenticator / 1Password / Aegis) is mandatory on every login.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
