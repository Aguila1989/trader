# =============================================================
# Atrium web frontend - BUILD-TIME configuration (Vite)
# Copy to web/.env. These are baked into the bundle at `npm run build`
# (they are NOT read at server boot - that's the root .env).
# =============================================================

# Personal solo-operator build (counterpart of SINGLE_USER in the root .env -
# set BOTH or neither). true = the SPA treats the operator as permanently
# signed in and hides every SaaS surface (login/register, pricing/upgrade,
# billing, 2FA, GDPR tools, transparency). Leave unset/false for the
# multi-tenant product build.
# VITE_SINGLE_USER=true

# Optional Sentry error monitoring for the frontend (blank = fully disabled).
# VITE_SENTRY_DSN=
